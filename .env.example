APP_NAME="Production AI Research Agent"
APP_ENV=development
LOG_LEVEL=INFO

# mock | openai | google
LLM_PROVIDER=mock

# OpenAI example:
LLM_MODEL=gpt-5.4-mini
OPENAI_API_KEY=

# Google example:
GOOGLE_API_KEY=

MAX_RESEARCH_STEPS=5
MAX_ITERATIONS=2

TAVILY_API_KEY=

MAX_SEARCH_RESULTS=4
MAX_SOURCES=12
SEARCH_TIMEOUT_SECONDS=15