APP_NAME="Production AI Research Agent"
APP_ENV=development
LOG_LEVEL=INFO

# mock | openai | google
LLM_PROVIDER=mock

# OpenAI example:
LLM_MODEL=gpt-5.4-mini
OPENAI_API_KEY=

# Google example:
GOOGLE_API_KEY=

MAX_RESEARCH_STEPS=5
MAX_ITERATIONS=2

TAVILY_API_KEY=

MAX_SEARCH_RESULTS=4
MAX_SOURCES=12
SEARCH_TIMEOUT_SECONDS=15

VERIFICATION_MIN_COVERAGE=0.85
MAX_TARGETED_QUERIES=3
MAX_TOOL_CALLS=15
GRAPH_RECURSION_LIMIT=25

POSTGRES_URI=postgresql://research:research@localhost:5433/research_agent?sslmode=disable

REDIS_URL=redis://localhost:6380/0
REDIS_CACHE_TTL_SECONDS=900

LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development